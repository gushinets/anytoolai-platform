# Copy this file to .env.prod (already gitignored via .gitignore's `.env.*` rule) and fill in
# real values from your secret store. Never commit .env.prod -- these are production secrets.
#
# `make prod-up` / `prod-status` / `prod-down` pick .env.prod up automatically if it exists
# (scripts/agent/runner.py passes it to `docker compose --env-file`), no manual `export` needed.
# A value exported in your shell still overrides whatever is in this file.
ANYTOOLAI_POSTGRES_USER=
ANYTOOLAI_POSTGRES_PASSWORD=
ANYTOOLAI_POSTGRES_DB=

# Stakeholder workflow demo. Keep every value outside version control and rotate the shared
# access code after the invited review window. The API needs both ANYTOOLAI_* values; only the
# worker receives the provider key.
ANYTOOLAI_DEMO_ACCESS_CODE=
ANYTOOLAI_ATOM_LAB_ACCESS_CODE=
ANYTOOLAI_LIVE_CANARY_TOKEN=
OPENAI_API_KEY=

# Released products and quota mode. An explicitly empty unmetered list selects canonical quotas.
ANYTOOLAI_ENABLED_PRODUCT_IDS=proposal_ai
ANYTOOLAI_UNMETERED_PRODUCT_IDS=proposal_ai
ANYTOOLAI_LLM_HTTPS_PROXY=http://proxy-host:3128
ANYTOOLAI_PROD_WORKER_MEMORY_LIMIT=768M
ANYTOOLAI_PROD_API_PORT=8000
ANYTOOLAI_PROD_WEB_PORT=3000

# Atom Lab run admission limits. These non-secret, platform-api-only technical limits bound HTTP
# payloads and admission counts; they do not guarantee a selected model's context-window capacity.
ANYTOOLAI_ATOM_LAB_RUN_BODY_MAX_BYTES=393216
ANYTOOLAI_ATOM_LAB_RUN_INPUT_MAX_BYTES=262144
ANYTOOLAI_ATOM_LAB_RUN_PROMPT_MAX_BYTES=65536
ANYTOOLAI_ATOM_LAB_RUN_DAILY_LIMIT=100
ANYTOOLAI_ATOM_LAB_RUN_ACTIVE_LIMIT=1

# Atom Lab OpenAI model catalog. These values are not secrets. Keep account scope identical for
# platform-api and platform-worker; OPENAI_API_KEY is still passed only to the worker.
ANYTOOLAI_MODEL_CATALOG_ACCOUNT_SCOPE=openai-default
ANYTOOLAI_MODEL_CATALOG_TTL_SECONDS=86400
ANYTOOLAI_MODEL_CATALOG_REFRESH_COOLDOWN_SECONDS=60
ANYTOOLAI_MODEL_CATALOG_LEASE_SECONDS=30
ANYTOOLAI_MODEL_CATALOG_FETCH_TIMEOUT_SECONDS=10
