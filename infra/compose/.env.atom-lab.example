# Copy this file to .env.atom-lab (gitignored via `.gitignore`'s `.env.*` rule), set owner-only
# mode 0600, and fill values from the approved secret store. Never commit .env.atom-lab.
# `atom-lab-*` commands load it automatically; an exported shell value takes precedence.
ANYTOOLAI_POSTGRES_USER=
ANYTOOLAI_POSTGRES_PASSWORD=
ANYTOOLAI_POSTGRES_DB=

# Keep these secrets unique across trust domains. The Lab code/live token reach only the API;
# only the worker receives the provider key. The optional /demo code may remain blank.
ANYTOOLAI_DEMO_ACCESS_CODE=
ANYTOOLAI_ATOM_LAB_ACCESS_CODE=
ANYTOOLAI_LIVE_CANARY_TOKEN=
OPENAI_API_KEY=

# The origin is operator-owned HTTPS ingress restricted to the approved internal network.
# Compose itself binds API and PostgreSQL to loopback only.
ANYTOOLAI_ATOM_LAB_INTERNAL_URL=
ANYTOOLAI_ATOM_LAB_API_PORT=8000
ANYTOOLAI_ATOM_LAB_POSTGRES_PORT=5432
ANYTOOLAI_ATOM_LAB_WORKER_MEMORY_LIMIT=768M
ANYTOOLAI_ATOM_LAB_QUIESCE_TIMEOUT=600

# Atom Lab may use direct provider egress. Leave blank unless its deployment requires a proxy.
ANYTOOLAI_LLM_HTTPS_PROXY=

# Non-secret admission limits. These bound HTTP payloads and accepted runs; they do not guarantee
# that a selected model has enough context-window capacity.
ANYTOOLAI_ATOM_LAB_RUN_BODY_MAX_BYTES=393216
ANYTOOLAI_ATOM_LAB_RUN_INPUT_MAX_BYTES=262144
ANYTOOLAI_ATOM_LAB_RUN_PROMPT_MAX_BYTES=65536
ANYTOOLAI_ATOM_LAB_RUN_DAILY_LIMIT=100
ANYTOOLAI_ATOM_LAB_RUN_ACTIVE_LIMIT=1

# Non-secret OpenAI model-catalog controls. Keep account scope identical for API and worker.
ANYTOOLAI_MODEL_CATALOG_ACCOUNT_SCOPE=openai-default
ANYTOOLAI_MODEL_CATALOG_TTL_SECONDS=86400
ANYTOOLAI_MODEL_CATALOG_REFRESH_COOLDOWN_SECONDS=60
ANYTOOLAI_MODEL_CATALOG_LEASE_SECONDS=30
ANYTOOLAI_MODEL_CATALOG_FETCH_TIMEOUT_SECONDS=10
