    "nextStepsSection": {
      "type": "object",
      "properties": {
        "id": { "const": "next-steps" },
        "title": { "const": "Questions to ask" },
        "content": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "metadata": { "$ref": "#/$defs/listSectionMetadata" }
      },
      "required": ["id", "title", "content", "metadata"],
      "additionalProperties": false
    },
    "sectionMetadata": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["heading", "paragraph", "list", "table", "note"]
        }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "listSectionMetadata": {
      "type": "object",
      "properties": {
        "kind": { "const": "list" }
      },
      "required": ["kind"],
      "additionalProperties": false
    }
  }
