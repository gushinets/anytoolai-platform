{
  "type": "object",
  "properties": {
    "brief": {
      "type": "object",
      "properties": {
        "values": {
          "type": "object",
          "properties": {
            "project_goal": {
              "type": "string",
              "minLength": 1
            },
            "deliverables": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "deadline": {
              "type": "string",
              "minLength": 1
            },
            "budget": {
              "type": "string",
              "minLength": 1
            },
            "target_audience": {
              "type": "string",
              "minLength": 1
            },
            "constraints": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "project_goal",
              "deliverables",
              "deadline",
              "budget",
              "target_audience",
              "constraints"
            ]
          }
        },
        "confidence": {
          "type": "object",
          "properties": {
            "project_goal": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "deliverables": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "deadline": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "budget": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "target_audience": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "constraints": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "values",
        "missing_fields"
      ],
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "missing_information",
              "ambiguity",
              "scope_risk",
              "timeline_risk",
              "budget_risk",
              "contradiction"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "category",
          "description",
          "severity"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "source_issue_index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "question",
          "rationale",
          "priority",
          "category",
          "source_issue_index"
        ],
        "additionalProperties": false
      }
    },
    "document": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "metadata": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "heading",
                      "paragraph",
                      "list",
                      "table",
                      "note"
                    ]
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "title",
              "content"
            ],
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "sections",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "brief",
    "issues",
    "questions",
    "document"
  ],
  "additionalProperties": false
}
