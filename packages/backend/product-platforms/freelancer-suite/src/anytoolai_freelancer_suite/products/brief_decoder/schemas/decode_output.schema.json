  "then": { "properties": { "questions": { "maxItems": 0 } } },
  "$defs": {
    "overviewSection": {
      "type": "object",
      "properties": {
        "id": { "const": "overview" },
        "title": { "const": "Project overview" },
        "content": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "metadata": { "$ref": "#/$defs/sectionMetadata" }
      },
      "required": ["id", "title", "content"],
      "additionalProperties": false
    },
    "keyDetailsSection": {
      "type": "object",
      "properties": {
        "id": { "const": "key-details" },
        "title": { "const": "Key details" },
        "content": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "metadata": { "$ref": "#/$defs/listSectionMetadata" }
      },
      "required": ["id", "title", "content", "metadata"],
      "additionalProperties": false
    },
    "gapsSection": {
      "type": "object",
      "properties": {
        "id": { "const": "gaps" },
        "title": { "const": "Gaps and risks" },
        "content": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "metadata": { "$ref": "#/$defs/sectionMetadata" }
      },
      "required": ["id", "title", "content"],
      "additionalProperties": false
