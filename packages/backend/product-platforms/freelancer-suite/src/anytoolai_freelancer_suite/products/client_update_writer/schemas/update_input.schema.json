{
  "type": "object",
  "properties": {
    "progress_notes": {
      "type": "string",
      "minLength": 1
    },
    "tone": {
      "type": "string",
      "enum": ["neutral", "warm", "firm"]
    },
    "constraints": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "output_format": {
          "type": "string",
          "enum": ["plain_text", "markdown", "html"]
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["progress_notes", "tone"],
  "additionalProperties": false
}
