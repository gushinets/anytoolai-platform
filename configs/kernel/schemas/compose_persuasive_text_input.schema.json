{
  "type": "object",
  "properties": {
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "angle": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "object",
      "properties": {
        "tone": {
          "type": "string",
          "enum": ["neutral", "warm", "firm"]
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "format": {
          "type": "string",
          "enum": ["plain_text", "markdown", "html"]
        },
        "forbidden_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "plain_text_lists": {
          "type": "string",
          "enum": ["allowed", "forbidden"]
        },
        "numbers_must_appear_in_context": {
          "type": "boolean"
        },
        "claims_to_avoid": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["description"],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["context", "objective"],
  "additionalProperties": false
}
