{
  "type": "object",
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["heading", "paragraph", "list", "table", "note"]
              }
            },
            "required": ["kind"],
            "additionalProperties": false
          }
        },
        "required": ["id", "title", "content"],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": ["sections", "summary"],
  "additionalProperties": false
}
