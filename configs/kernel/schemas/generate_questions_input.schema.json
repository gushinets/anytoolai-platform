{
  "type": "object",
  "properties": {
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["category", "description", "severity"],
        "additionalProperties": false
      }
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "target_audience": {
      "type": "string",
      "minLength": 1
    },
    "max_questions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 5
    }
  },
  "required": ["issues", "context", "target_audience"],
  "additionalProperties": false
}
