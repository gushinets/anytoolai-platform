{
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "deltas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["match", "partial", "mismatch"]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["criterion_id", "status", "evidence"],
        "additionalProperties": false
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": ["verdict", "confidence", "deltas", "rationale"],
  "additionalProperties": false
}
