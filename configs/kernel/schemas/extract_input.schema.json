      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "enum": ["string", "number", "integer", "boolean", "date", "array_of_strings"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": ["name", "type", "description", "required"],
        "additionalProperties": false
      }
    },
    "strict": {
      "type": "boolean",
      "default": false
    }
  },
  "required": ["source_text", "fields"],
  "additionalProperties": false
}
